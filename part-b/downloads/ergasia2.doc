{\*\ftnsep\chftnsep}\pgndec\pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs28\b\f6\loch
\u917\'c5\u961\'f1\u947\'e3\u945\'e1\u963\'f3\u943\'df\u945\'e1 2 - \u916\'c4\u965\'f5\u957\'ed\u945\'e1\u956\'ec\u953\'e9\u954\'ea\u972\'fc\u962\'f2 \u921\'c9\u963\'f3\u964\'f4\u959\'ef\u967\'f7\u974\'fe\u961\'f1\u959\'ef\u962\'f2 \u924\'cc\u945\'e1\u952\'e8\u942\'de\u956\'ec\u945\'e1\u964\'f4\u959\'ef\u962\'f2}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql\hich\af6\loch\fs22\b0\f6\loch

\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b\f6\loch
\u931\'d3\u964\'f4\u972\'fc\u967\'f7\u959\'ef\u953\'e9:}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
1. \u924\'cc\u949\'e5\u964\'f4\u945\'e1\u964\'f4\u961\'f1\u959\'ef\u960\'f0\u942\'de \u964\'f4\u959\'ef\u965\'f5 \u963\'f3\u964\'f4\u945\'e1\u964\'f4\u953\'e9\u954\'ea\u959\'ef\u973\'fd \u953\'e9\u963\'f3\u964\'f4\u959\'ef\u967\'f7\u974\'fe\u961\'f1\u959\'ef\u965\'f5 \u964\'f4\u959\'ef\u965\'f5 \u924\'cc\u941\'dd\u961\'f1\u959\'ef\u965\'f5\u962\'f2 \u913\'c1 \u963\'f3\u949\'e5 \u948\'e4\u965\'f5\u957\'ed\u945\'e1\u956\'ec\u953\'e9\u954\'ea\u972\'fc website \u956\'ec\u949\'e5 PHP & MySQL \u954\'ea\u945\'e1\u953\'e9 \u956\'ec\u951\'e7\u967\'f7\u945\'e1\u957\'ed\u953\'e9\u963\'f3\u956\'ec\u972\'fc login.}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
2. \u933\'d5\u955\'eb\u959\'ef\u960\'f0\u959\'ef\u943\'df\u951\'e7\u963\'f3\u951\'e7 \u961\'f1\u972\'fc\u955\'eb\u969\'f9\u957\'ed Student/Tutor \u956\'ec\u949\'e5 \u948\'e4\u953\'e9\u945\'e1\u966\'f6\u959\'ef\u961\'f1\u949\'e5\u964\'f4\u953\'e9\u954\'ea\u940\'dc \u948\'e4\u953\'e9\u954\'ea\u945\'e1\u953\'e9\u974\'fe\u956\'ec\u945\'e1\u964\'f4\u945\'e1 \u960\'f0\u961\'f1\u972\'fc\u963\'f3\u946\'e2\u945\'e1\u963\'f3\u951\'e7\u962\'f2 \u954\'ea\u945\'e1\u953\'e9 \u960\'f0\u961\'f1\u959\'ef\u946\'e2\u959\'ef\u955\'eb\u942\'de\u962\'f2 \u960\'f0\u949\'e5\u961\'f1\u953\'e9\u949\'e5\u967\'f7\u959\'ef\u956\'ec\u941\'dd\u957\'ed\u959\'ef\u965\'f5.}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
3. \u916\'c4\u953\'e9\u945\'e1\u967\'f7\u949\'e5\u943\'df\u961\'f1\u953\'e9\u963\'f3\u951\'e7 (CRUD) \u945\'e1\u957\'ed\u945\'e1\u954\'ea\u959\'ef\u953\'e9\u957\'ed\u974\'fe\u963\'f3\u949\'e5\u969\'f9\u957\'ed, \u949\'e5\u947\'e3\u947\'e3\u961\'f1\u940\'dc\u966\'f6\u969\'f9\u957\'ed, \u949\'e5\u961\'f1\u947\'e3\u945\'e1\u963\'f3\u953\'e9\u974\'fe\u957\'ed \u954\'ea\u945\'e1\u953\'e9 \u967\'f7\u961\'f1\u951\'e7\u963\'f3\u964\'f4\u974\'fe\u957\'ed \u945\'e1\u960\'f0\u972\'fc \u964\'f4\u959\'ef\u957\'ed Tutor.}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql\hich\af6\loch\fs22\b0\f6\loch

\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b\f6\loch
\u913\'c1\u960\'f0\u945\'e1\u953\'e9\u964\'f4\u942\'de\u963\'f3\u949\'e5\u953\'e9\u962\'f2:}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
- \u931\'d3\u949\'e5\u955\'eb\u943\'df\u948\'e4\u945\'e1 \u960\'f0\u953\'e9\u963\'f3\u964\'f4\u959\'ef\u960\'f0\u959\'ef\u943\'df\u951\'e7\u963\'f3\u951\'e7\u962\'f2 (login) \u956\'ec\u949\'e5 login/password.}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
- \u914\'c2\u940\'dc\u963\'f3\u951\'e7 \u948\'e4\u949\'e5\u948\'e4\u959\'ef\u956\'ec\u941\'dd\u957\'ed\u969\'f9\u957\'ed \u956\'ec\u949\'e5 \u960\'f0\u943\'df\u957\'ed\u945\'e1\u954\'ea\u949\'e5\u962\'f2 \u947\'e3\u953\'e9\u945\'e1 \u967\'f7\u961\'f1\u942\'de\u963\'f3\u964\'f4\u949\'e5\u962\'f2, \u945\'e1\u957\'ed\u945\'e1\u954\'ea\u959\'ef\u953\'e9\u957\'ed\u974\'fe\u963\'f3\u949\'e5\u953\'e9\u962\'f2, \u941\'dd\u947\'e3\u947\'e3\u961\'f1\u945\'e1\u966\'f6\u945\'e1 \u954\'ea\u945\'e1\u953\'e9 \u949\'e5\u961\'f1\u947\'e3\u945\'e1\u963\'f3\u943\'df\u949\'e5\u962\'f2.}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
- \u916\'c4\u953\'e9\u945\'e1\u966\'f6\u959\'ef\u961\'f1\u949\'e5\u964\'f4\u953\'e9\u954\'ea\u942\'de \u960\'f0\u961\'f1\u959\'ef\u946\'e2\u959\'ef\u955\'eb\u942\'de \u960\'f0\u949\'e5\u961\'f1\u953\'e9\u949\'e5\u967\'f7\u959\'ef\u956\'ec\u941\'dd\u957\'ed\u959\'ef\u965\'f5 \u945\'e1\u957\'ed\u940\'dc \u961\'f1\u972\'fc\u955\'eb\u959\'ef (Student/Tutor).}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
- \u915\'c3\u953\'e9\u945\'e1 Tutor: \u960\'f0\u961\'f1\u959\'ef\u963\'f3\u952\'e8\u942\'de\u954\'ea\u951\'e7/\u949\'e5\u960\'f0\u949\'e5\u958\'ee\u949\'e5\u961\'f1\u947\'e3\u945\'e1\u963\'f3\u943\'df\u945\'e1/\u948\'e4\u953\'e9\u945\'e1\u947\'e3\u961\'f1\u945\'e1\u966\'f6\u942\'de \u945\'e1\u957\'ed\u945\'e1\u954\'ea\u959\'ef\u953\'e9\u957\'ed\u974\'fe\u963\'f3\u949\'e5\u969\'f9\u957\'ed, \u967\'f7\u961\'f1\u951\'e7\u963\'f3\u964\'f4\u974\'fe\u957\'ed, \u949\'e5\u961\'f1\u947\'e3\u945\'e1\u963\'f3\u953\'e9\u974\'fe\u957\'ed \u954\'ea\u945\'e1\u953\'e9 \u949\'e5\u947\'e3\u947\'e3\u961\'f1\u940\'dc\u966\'f6\u969\'f9\u957\'ed.}
\par \pard\plain \s0\rtlch\af9\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\ql{\hich\af6\loch\fs22\b0\f6\loch
- \u916\'c4\u953\'e9\u945\'e1\u964\'f4\u942\'de\u961\'f1\u951\'e7\u963\'f3\u951\'e7 \u964\'f4\u951\'e7\u962\'f2 \u947\'e3\u949\'e5\u957\'ed\u953\'e9\u954\'ea\u942\'de\u962\'f2 \u948\'e4\u959\'ef\u956\'ec\u942\'de\u962\'f2/\u960\'f0\u955\'eb\u959\'ef\u942\'de\u947\'e3\u951\'e7\u963\'f3\u951\'e7\u962\'f2 \u964\'f4\u959\'ef\u965\'f5 \u924\'cc\u941\'dd\u961\'f1\u959\'ef\u965\'f5\u962\'f2 \u913\'c1 (\u943\'df\u948\'e4\u953\'e9\u945\'e1 layout \u954\'ea\u945\'e1\u953\'e9 \u954\'ea\u959\'ef\u965\'f5\u956\'ec\u960\'f0\u953\'e9\u940\'dc-\u949\'e5\u953\'e9\u954\'ea\u972\'fc\u957\'ed\u949\'e5\u962\'f2).}
\par }