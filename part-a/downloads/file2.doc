\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u924\'cc\u960\'f0\u959\'ef\u961\'f1\u949\'e5\u943\'df \u957\'ed\u945\'e1 \u967\'f7\u961\'f1\u951\'e7\u963\'f3\u953\'e9\u956\'ec\u959\'ef\u960\'f0\u959\'ef\u953\'e9\u951\'e7\u952\'e8\u949\'e5\u943\'df \u963\'f3\u949\'e5 \u954\'ea\u940\'dc\u952\'e8\u949\'e5 \u949\'e5\u943\'df\u948\'e4\u959\'ef\u965\'f5\u962\'f2 \u945\'e1\u961\'f1\u967\'f7\u949\'e5\u943\'df\u959\'ef\u965\'f5 XML, \u972\'fc\u960\'f0\u969\'f9\u962\'f2 plain XML \u954\'ea\u945\'e1\u953\'e9 SVG}
\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u919\'c7 \u960\'f0\u953\'e9\u959\'ef \u963\'f3\u965\'f5\u967\'f7\u957\'ed\u942\'de \u967\'f7\u961\'f1\u942\'de\u963\'f3\u951\'e7 \u964\'f4\u959\'ef\u965\'f5 \u949\'e5\u943\'df\u957\'ed\u945\'e1\u953\'e9 \u947\'e3\u953\'e9\u945\'e1 \u964\'f4\u951\'e7\u957\'ed \u945\'e1\u955\'eb\u955\'eb\u945\'e1\u947\'e3\u942\'de \u964\'f4\u959\'ef\u965\'f5 \u963\'f3\u964\'f4\u965\'f5\u955\'eb \u953\'e9\u963\'f3\u964\'f4\u959\'ef\u963\'f3\u949\'e5\u955\'eb\u943\'df\u948\'e4\u969\'f9\u957\'ed \u947\'e3\u961\'f1\u945\'e1\u956\'ec\u956\'ec\u941\'dd\u957\'ed\u969\'f9\u957\'ed \u963\'f3\u949\'e5 HTML}
\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u924\'cc\u945\'e1\u950\'e6\u943\'df \u956\'ec\u949\'e5 \u964\'f4\u951\'e7\u957\'ed HTML \u954\'ea\u945\'e1\u953\'e9 \u964\'f4\u951\'e7\u957\'ed JavaScript, \u964\'f4\u959\'ef CSS \u945\'e1\u960\'f0\u959\'ef\u964\'f4\u949\'e5\u955\'eb\u949\'e5\u943\'df \u946\'e2\u945\'e1\u963\'f3\u953\'e9\u954\'ea\u942\'de \u964\'f4\u949\'e5\u967\'f7\u957\'ed\u959\'ef\u955\'eb\u959\'ef\u947\'e3\u943\'df\u945\'e1 \u960\'f0\u959\'ef\u965\'f5 \u967\'f7\u961\'f1\u951\'e7\u963\'f3\u953\'e9\u956\'ec\u959\'ef\u960\'f0\u959\'ef\u953\'e9\u949\'e5\u943\'df\u964\'f4\u945\'e1\u953\'e9 \u954\'ea\u945\'e1\u964\'f4\u940\'dc \u954\'ea\u972\'fc\u961\'f1\u959\'ef\u957\'ed \u963\'f3\u942\'de\u956\'ec\u949\'e5\u961\'f1\u945\'e1 \u947\'e3\u953\'e9\u945\'e1 \u964\'f4\u951\'e7 \u948\'e4\u951\'e7\u956\'ec\u953\'e9\u959\'ef\u965\'f5\u961\'f1\u947\'e3\u943\'df\u945\'e1 \u953\'e9\u963\'f3\u964\'f4\u959\'ef\u963\'f3\u949\'e5\u955\'eb\u943\'df\u948\'e4\u969\'f9\u957\'ed \u954\'ea\u945\'e1\u953\'e9 \u948\'e4\u953\'e9\u949\'e5\u960\'f0\u945\'e1\u966\'f6\u974\'fe\u957\'ed \u967\'f7\u961\'f1\u942\'de\u963\'f3\u964\'f4\u951\'e7 \u947\'e3\u953\'e9\u945\'e1 web \u954\'ea\u945\'e1\u953\'e9 mobile applications}
\par \pard\plain \s0\rtlch\af10\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\sl0\slmult0\ql\fi0\li0\lin0\ri0\rin0\sb0\sa0\rtlch\afs30\ab0 \ltrch\hich\af6\loch\fs30\b0\f6\loch

\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u931\'d3\u967\'f7\u949\'e5\u948\'e4\u953\'e9\u940\'dc\u963\'f3\u964\'f4\u951\'e7\u954\'ea\u949\'e5 \u954\'ea\u965\'f5\u961\'f1\u943\'df\u969\'f9\u962\'f2 \u947\'e3\u953\'e9\u945\'e1 \u957\'ed\u945\'e1 \u948\'e4\u953\'e9\u949\'e5\u965\'f5\u954\'ea\u959\'ef\u955\'eb\u973\'fd\u957\'ed\u949\'e5\u953\'e9 \u964\'f4\u959\'ef\u957\'ed \u948\'e4\u953\'e9\u945\'e1\u967\'f7\u969\'f9\u961\'f1\u953\'e9\u963\'f3\u956\'ec\u972\'fc \u964\'f4\u959\'ef\u965\'f5 \u960\'f0\u949\'e5\u961\'f1\u953\'e9\u949\'e5\u967\'f7\u959\'ef\u956\'ec\u941\'dd\u957\'ed\u959\'ef\u965\'f5 \u964\'f4\u959\'ef\u965\'f5 \u949\'e5\u947\'e3\u947\'e3\u961\'f1\u940\'dc\u966\'f6\u959\'ef\u965\'f5 \u945\'e1\u960\'f0\u972\'fc \u964\'f4\u951\'e7\u957\'ed \u960\'f0\u945\'e1\u961\'f1\u959\'ef\u965\'f5\u963\'f3\u943\'df\u945\'e1\u963\'f3\u942\'de \u964\'f4\u959\'ef\u965\'f5, \u947\'e3\u953\'e9\u945\'e1 \u955\'eb\u972\'fc\u947\'e3\u959\'ef\u965\'f5\u962\'f2 \u960\'f0\u961\'f1\u959\'ef\u963\'f3\u946\'e2\u945\'e1\u963\'f3\u953\'e9\u956\'ec\u972\'fc\u964\'f4\u951\'e7\u964\'f4\u945\'e1\u962\'f2, \u949\'e5\u965\'f5\u949\'e5\u955\'eb\u953\'e9\u958\'ee\u943\'df\u945\'e1\u962\'f2, \u949\'e5\u965\'f5\u954\'ea\u959\'ef\u955\'eb\u972\'fc\u964\'f4\u949\'e5\u961\'f1\u951\'e7\u962\'f2 \u948\'e4\u953\'e9\u945\'e1\u956\'ec\u959\'ef\u943\'df\u961\'f1\u945\'e1\u963\'f3\u951\'e7\u962\'f2 \u954\'ea\u945\'e1\u953\'e9 \u956\'ec\u953\'e9\u954\'ea\u961\'f1\u972\'fc\u964\'f4\u949\'e5\u961\'f1\u951\'e7\u962\'f2 \u960\'f0\u959\'ef\u955\'eb\u965\'f5\u960\'f0\u955\'eb\u959\'ef\u954\'ea\u972\'fc\u964\'f4\u951\'e7\u964\'f4\u945\'e1\u962\'f2 \u955\'eb\u972\'fc\u947\'e3\u969\'f9 \u964\'f4\u951\'e7\u962\'f2 \u949\'e5\u955\'eb\u945\'e1\u967\'f7\u953\'e9\u963\'f3\u964\'f4\u959\'ef\u960\'f0\u959\'ef\u943\'df\u951\'e7\u963\'f3\u951\'e7\u962\'f2 \u964\'f4\u951\'e7\u962\'f2 \u949\'e5\u960\'f0\u945\'e1\u957\'ed\u940\'dc\u955\'eb\u951\'e7\u968\'f8\u951\'e7\u962\'f2 \u954\'ea\u974\'fe\u948\'e4\u953\'e9\u954\'ea\u945\'e1 \u963\'f3\u964\'f4\u951\'e7 \u948\'e4\u972\'fc\u956\'ec\u951\'e7\u963\'f3\u951\'e7 \u964\'f4\u959\'ef\u965\'f5 \u960\'f0\u949\'e5\u961\'f1\u953\'e9\u949\'e5\u967\'f7\u959\'ef\u956\'ec\u941\'dd\u957\'ed\u959\'ef\u965\'f5}
\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u916\'c4\u943\'df\u957\'ed\u949\'e5\u953\'e9 \u963\'f3\u964\'f4\u959\'ef \u963\'f3\u967\'f7\u949\'e5\u948\'e4\u953\'e9\u945\'e1\u963\'f3\u964\'f4\u942\'de/ \u960\'f0\u961\'f1\u959\'ef\u947\'e3\u961\'f1\u945\'e1\u956\'ec\u956\'ec\u945\'e1\u964\'f4\u953\'e9\u963\'f3\u964\'f4\u942\'de \u964\'f4\u951\'e7 \u948\'e4\u965\'f5\u957\'ed\u945\'e1\u964\'f4\u972\'fc\u964\'f4\u951\'e7\u964\'f4\u945\'e1 \u957\'ed\u945\'e1 \u948\'e4\u953\'e9\u945\'e1\u967\'f7\u969\'f9\u961\'f1\u943\'df\u963\'f3\u949\'e5\u953\'e9 \u964\'f4\u953\'e9\u962\'f2 \u959\'ef\u948\'e4\u951\'e7\u947\'e3\u943\'df\u949\'e5\u962\'f2 \u963\'f3\u967\'f7\u949\'e5\u964\'f4\u953\'e9\u954\'ea\u940\'dc \u956\'ec\u949\'e5 \u964\'f4\u959\'ef \u960\'f0\u974\'fe\u962\'f2 \u952\'e8\u945\'e1 \u949\'e5\u956\'ec\u966\'f6\u945\'e1\u957\'ed\u943\'df\u950\'e6\u959\'ef\u957\'ed\u964\'f4\u945\'e1\u953\'e9 \u964\'f4\u945\'e1 \u948\'e4\u953\'e9\u940\'dc\u966\'f6\u959\'ef\u961\'f1\u945\'e1 \u963\'f3\u964\'f4\u959\'ef\u953\'e9\u967\'f7\u949\'e5\u943\'df\u945\'e1 \u963\'f3\u964\'f4\u951\'e7\u957\'ed \u953\'e9\u963\'f3\u964\'f4\u959\'ef\u963\'f3\u949\'e5\u955\'eb\u943\'df\u948\'e4\u945\'e1 \u963\'f3\u949\'e5 \u941\'dd\u957\'ed\u945\'e1 \u958\'ee\u949\'e5\u967\'f7\u969\'f9\u961\'f1\u953\'e9\u963\'f3\u964\'f4\u972\'fc \u945\'e1\u961\'f1\u967\'f7\u949\'e5\u943\'df\u959\'ef \u942\'de \u963\'f3\u949\'e5 \u956\'ec\u953\'e9\u945\'e1 \u949\'e5\u957\'ed\u972\'fc\u964\'f4\u951\'e7\u964\'f4\u945\'e1 \u964\'f4\u959\'ef\u965\'f5 \u949\'e5\u947\'e3\u947\'e3\u961\'f1\u940\'dc\u966\'f6\u959\'ef\u965\'f5 HTML}
\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u904\'b8\u964\'f4\u963\'f3\u953\'e9, \u948\'e4\u953\'e9\u945\'e1\u964\'f4\u951\'e7\u961\'f1\u974\'fe\u957\'ed\u964\'f4\u945\'e1\u962\'f2 \u964\'f4\u953\'e9\u962\'f2 \u959\'ef\u948\'e4\u951\'e7\u947\'e3\u943\'df\u949\'e5\u962\'f2 \u963\'f3\u964\'f4\u965\'f5\u955\'eb \u963\'f3\u949\'e5 \u949\'e5\u958\'ee\u969\'f9\u964\'f4\u949\'e5\u961\'f1\u953\'e9\u954\'ea\u940\'dc .css \u945\'e1\u961\'f1\u967\'f7\u949\'e5\u943\'df\u945\'e1, \u956\'ec\u960\'f0\u959\'ef\u961\'f1\u949\'e5\u943\'df \u957\'ed\u945\'e1 \u945\'e1\u955\'eb\u955\'eb\u940\'dc\u958\'ee\u949\'e5\u953\'e9 \u956\'ec\u949\'e5 \u960\'f0\u959\'ef\u955\'eb\u973\'fd \u949\'e5\u973\'fd\u954\'ea\u959\'ef\u955\'eb\u959\'ef \u964\'f4\u961\'f1\u972\'fc\u960\'f0\u959\'ef \u964\'f4\u951\'e7\u957\'ed \u949\'e5\u956\'ec\u966\'f6\u940\'dc\u957\'ed\u953\'e9\u963\'f3\u951\'e7 \u960\'f0\u959\'ef\u955\'eb\u955\'eb\u974\'fe\u957\'ed \u953\'e9\u963\'f3\u964\'f4\u959\'ef\u963\'f3\u949\'e5\u955\'eb\u943\'df\u948\'e4\u969\'f9\u957\'ed, \u947\'e3\u955\'eb\u953\'e9\u964\'f4\u974\'fe\u957\'ed\u959\'ef\u957\'ed\u964\'f4\u945\'e1\u962\'f2 \u954\'ea\u972\'fc\u960\'f0\u959\'ef \u954\'ea\u945\'e1\u953\'e9 \u967\'f7\u961\'f1\u972\'fc\u957\'ed\u959\'ef}
\par \pard\plain \s0\rtlch\af10\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af3\loch\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1032\kerning1\dbch\af7\langfe2052\sl0\slmult0\ql\fi0\li0\lin0\ri0\rin0\sb0\sa0\rtlch\afs30\ab0 \ltrch\hich\af6\loch\fs30\b0\f6\loch

\par \pard\plain \s23\rtlch\af11\afs24\alang1081 \ltrch\lang1032\langfe2052\hich\af5\loch\sl0\slmult0\ql\nowidctlpar\hyphpar0\sb283\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs64\expnd0\expndtw0\lang1032\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\dbch\af9\langfe2052\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u915\'c3\u953\'e9\u945\'e1 \u964\'f4\u959\'ef\u957\'ed \u955\'eb\u972\'fc\u947\'e3\u959\'ef \u945\'e1\u965\'f5\u964\'f4\u972\'fc, \u964\'f4\u959\'ef World Wide Web Consortium (W3C) \u948\'e4\u951\'e7\u956\'ec\u953\'e9\u959\'ef\u973\'fd\u961\'f1\u947\'e3\u951\'e7\u963\'f3\u949\'e5 \u964\'f4\u959\'ef CSS, \u956\'ec\u949\'e5 \u963\'f3\u964\'f4\u972\'fc\u967\'f7\u959\'ef \u964\'f4\u959\'ef \u948\'e4\u953\'e9\u945\'e1\u967\'f7\u969\'f9\u961\'f1\u953\'e9\u963\'f3\u956\'ec\u972\'fc \u972\'fc\u955\'eb\u951\'e7\u962\'f2 \u964\'f4\u951\'e7\u962\'f2 \u956\'ec\u959\'ef\u961\'f1\u966\'f6\u959\'ef\u960\'f0\u959\'ef\u943\'df\u951\'e7\u963\'f3\u951\'e7\u962\'f2 \u945\'e1\u960\'f0\u972\'fc \u964\'f4\u959\'ef HTML \u941\'dd\u947\'e3\u947\'e3\u961\'f1\u945\'e1\u966\'f6\u959\'ef, \u954\'ea\u945\'e1\u953\'e9 \u964\'f4\u951\'e7\u957\'ed \u945\'e1\u960\'f0\u959\'ef\u952\'e8\u942\'de\u954\'ea\u949\'e5\u965\'f5\u963\'f3\u942\'de \u964\'f4\u959\'ef\u965\'f5 \u963\'f3\u949\'e5 \u941\'dd\u957\'ed\u945\'e1 \u958\'ee\u949\'e5\u967\'f7\u969\'f9\u961\'f1\u953\'e9\u963\'f3\u964\'f4\u972\'fc \u945\'e1\u961\'f1\u967\'f7\u949\'e5\u943\'df\u959\'ef CSS. \u931\'d3\u965\'f5\u957\'ed\u949\'e5\u960\'f0\u974\'fe\u962\'f2, \u964\'f4\u959\'ef CSS:}
\par \pard\plain \s24\hich\af5\loch\sl0\slmult0\ql\sb227\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs48\expnd0\expndtw0\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u922\'ca\u945\'e1\u952\'e8\u959\'ef\u961\'f1\u943\'df\u950\'e6\u949\'e5\u953\'e9 \u964\'f4\u959\'ef \u949\'e5\u960\'f0\u943\'df\u960\'f0\u949\'e5\u948\'e4\u959\'ef \u960\'f0\u945\'e1\u961\'f1\u959\'ef\u965\'f5\u963\'f3\u943\'df\u945\'e1\u963\'f3\u951\'e7\u962\'f2 (presentation layer) \u964\'f4\u951\'e7\u962\'f2 \u948\'e4\u953\'e9\u949\'e5\u960\'f0\u945\'e1\u966\'f6\u942\'de\u962\'f2 \u967\'f7\u961\'f1\u942\'de\u963\'f3\u964\'f4\u951\'e7}
\par \pard\plain \s24\hich\af5\loch\sl0\slmult0\ql\sb227\sa0\ltrpar\scaps0\caps0\cf1\outl0\strike0\f5\fs48\expnd0\expndtw0\i0\shad0\ulnone\ulc0\b0\kerning1\accnone\sl0\slmult0\fi0\li0\lin0\ri0\rin0\sb240\sa0{\rtlch\afs30 \ltrch\hich\af6\loch\fs30\f6\loch
\u927\'cf\u961\'f1\u943\'df\u950\'e6\u949\'e5\u953\'e9 \u963\'f3\u964\'f4\u959\'ef\u957\'ed \u960\'f0\u949\'e5\u961\'f1\u953\'e9\u951\'e7\u947\'e3\u951\'e7\u964\'f4\u942\'de \u964\'f4\u959\'ef \u960\'f0\u974\'fe\u962\'f2 \u960\'f0\u961\'f1\u941\'dd\u960\'f0\u949\'e5\u953\'e9 \u957\'ed\u945\'e1 \u960\'f0\u945\'e1\u961\'f1\u959\'ef\u965\'f5\u963\'f3\u953\'e9\u945\'e1\u963\'f3\u964\'f4\u949\'e5\u943\'df \u964\'f4\u959\'ef \u954\'ea\u940\'dc\u952\'e8\u949\'e5 \u963\'f3\u964\'f4\u959\'ef\u953\'e9\u967\'f7\u949\'e5\u943\'df\u959\'ef \u963\'f3\u964\'f4\u951\'e7\u957\'ed \u959\'ef\u952\'e8\u972\'fc\u957\'ed\u951\'e7 \u964\'f4\u959\'ef\u965\'f5 \u967\'f7\u961\'f1\u942\'de\u963\'f3\u964\'f4\u951\'e7}
